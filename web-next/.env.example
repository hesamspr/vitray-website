# Where the contact / consultation form forwards leads after storing them locally.
# Defaults to the n8n webhook if unset.
CONTACT_WEBHOOK_URL=https://n8n.saeidpour.com/webhook/contact-us-form

# Optional: override where submissions are persisted (append-only JSONL).
# Defaults to <web-next>/data/contact-submissions.jsonl
# CONTACT_DATA_FILE=/var/www/website/web-next/data/contact-submissions.jsonl

# --- Admin view to browse leads at /admin/submissions ---
# The page is disabled (404) until ADMIN_PASSWORD is set. ADMIN_USER defaults to "admin".
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Anti-spam: Cloudflare Turnstile (optional but recommended) ---
# Create a free "Invisible" Turnstile widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Both unset = the check is skipped entirely (only the honeypot/timing/rate-limit
# guards run). If Turnstile's script is blocked/unreachable client-side (e.g.
# during a connectivity outage) the form still submits — see hooks/useTurnstile.ts
# and lib/turnstile.ts for the fail-open behavior.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key

# --- Email notification per lead (optional) ---
# If these are unset, no email is sent and nothing breaks. Set all of SMTP_HOST,
# SMTP_PORT, SMTP_USER, SMTP_PASS and LEADS_NOTIFY_TO to enable.
# SMTP_HOST=mail.vitrayco.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@vitrayco.com
# SMTP_PASS=your-mailbox-password
# LEADS_NOTIFY_TO=hello@vitrayco.com
# LEADS_NOTIFY_FROM=hello@vitrayco.com
